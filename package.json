        "@typescript-eslint/parser": "^6.0.0",
        "electron": "^30.0.0",
        "esbuild": "^0.20.0",
        "eslint": "^8.0.0",
        "typescript": "^5.4.0"
    },
    "dependencies": {
        "@electron/asar": "^4.3.0"
    }
